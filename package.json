{
  "name": "aetheria-chronicles-rpg",
  "productName": "Aetheria Chronicles: Sword & Forge",
  "version": "1.0.0",
  "description": "A 60 FPS top-down oblique real-time action RPG with sword skills, deep blacksmithing, housing, guilds and an infinite abyss - TypeScript + Canvas 2D + Web Audio + Electron.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -n vite,electron -c magenta,cyan \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron . --dev\"",
    "electron": "electron .",
    "start": "npm run build && electron ."
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "electron": "^39.8.10",
    "typescript": "~5.8.3",
    "vite": "^6.4.6",
    "wait-on": "^8.0.5"
  },
  "license": "MIT"
}
